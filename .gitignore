# =============================================================================
# study/.gitignore
#
# Repository policy:
#   - Source code (.py, .ipynb, .md, .yaml, configs, prompts) IS committed.
#   - Lightweight result artifacts (CSV metrics, JSON reports, PNG figures) ARE
#     committed so results can be inspected without rerunning experiments.
#   - Heavy binary artifacts (trained models, raw LLM dumps, embedding caches)
#     are EXCLUDED — they are reproducible from code + data.
#   - Author-private and thesis-related materials are EXCLUDED.
# =============================================================================

# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Test / type-check / coverage caches
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_meta

# -----------------------------------------------------------------------------
# Secrets / credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# -----------------------------------------------------------------------------
# Local dev tooling configs (not needed on GitHub)
# -----------------------------------------------------------------------------
.cursor/
.cursorignore
.cursorindexingignore
.windsurf/

# -----------------------------------------------------------------------------
# Author-private / thesis materials (NOT for the public repo)
# -----------------------------------------------------------------------------
# Whole thesis directory: ~150+ MB of docx / pptx / xlsx / md drafts and reviews.
защита/

# Author-private files at the repository root.
AI_DENTIST_defense.pptx
EXPERIMENT_PLAN.md
VKRS_FINANCE_CHAPTER_v2.md

# -----------------------------------------------------------------------------
# D1 — archived pre-Phase-5 artifacts (kept on disk for history, not in git)
# -----------------------------------------------------------------------------
d1/.archive_pre_phase5/
d1/data/.backup_phase4_pre_p5/

# -----------------------------------------------------------------------------
# Heavy binary artifacts (regenerated from code + data)
# -----------------------------------------------------------------------------
# ML models / serialized weights
*.joblib
*.pkl
*.pickle
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# Numpy / embedding dumps
*.npy
*.npz
*.faiss

# -----------------------------------------------------------------------------
# D4 — clinic-specific raw knowledge base (NOT for the public repo)
# -----------------------------------------------------------------------------
# Original clinic data (price list, doctors, contacts, aftercare .docx).
# d4/data/chunks_frozen.json is committed and is sufficient for
# analyze_existing notebook mode; rerunning retrieval from scratch requires
# providing your own kb/ with the same layout.
d4/raw_data/kb/

# -----------------------------------------------------------------------------
# D4 — per-run LLM dumps and enrichment caches
# -----------------------------------------------------------------------------
# Raw LLM responses for each retrieval mode (large, regenerated by run_new mode).
d4/outputs/runs/**/*.jsonl

# Enrichment cache (regenerated on demand by the pipeline).
d4/outputs/enrichment_cache/

# -----------------------------------------------------------------------------
# Logs / temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
.tmp/
